{
  "expo": {
    "name": "CivicTrack",
    "slug": "dsn-complaint-system",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "dsn",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0A0A",
    "splash": {
      "backgroundColor": "#0A0A0A",
      "resizeMode": "contain",
      "image": "./assets/splash-icon.png"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dsn.complaintsystem",
      "infoPlist": {
        "NSCameraUsageDescription": "CivicTrack uses your camera so you can photograph the issue you're reporting.",
        "NSPhotoLibraryUsageDescription": "CivicTrack needs access to your photos so you can attach existing images to a complaint.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.dsn.complaintsystem",
      "edgeToEdgeEnabled": true,
      "usesCleartextTraffic": true,
      "permissions": ["CAMERA", "READ_EXTERNAL_STORAGE", "WRITE_EXTERNAL_STORAGE"],
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "CivicTrack needs access to your photos so you can attach existing images to a complaint.",
          "cameraPermission": "CivicTrack uses your camera so you can photograph the issue you're reporting."
        }
      ]
    ]
  }
}
