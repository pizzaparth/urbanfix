{
  "name": "complaint-system-backend",
  "version": "1.0.0",
  "description": "Backend for Smart Digital Complaint Management and Public Transparency System",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed:admin": "node scripts/seedAdmin.js",
    "seed:roles": "node scripts/seedRoles.js",
    "seed:complaints": "node scripts/seedComplaints.js",
    "backfill:stage-ward": "node scripts/backfillStageAndWard.js",
    "backfill:public": "node scripts/backfillIsPublic.js",
    "backfill:urgency": "node scripts/backfillUrgencyLevels.js",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "test:load": "node tests/load/run.js",
    "audit:verify": "node scripts/verifyAuditLog.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.5",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.3.1",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.13",
    "pdfkit": "^0.15.0",
    "sharp": "^0.35.5",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "autocannon": "^9.0.0",
    "mongodb-memory-server": "^11.4.0",
    "nodemon": "^3.1.0",
    "supertest": "^7.3.2"
  },
  "engines": {
    "node": ">=20"
  }
}
