PORT=5001
MONGO_URI=mongodb://localhost:27017/complaint_system
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# Key for research record IDs (HMAC). Required: the server refuses to start without
# it. At least 32 bytes, different from JWT_SECRET, kept only in the server
# environment. Generate with: openssl rand -hex 32
# Rotating it changes every research record ID (new exports stop joining old ones).
RESEARCH_HMAC_KEY=

# Vision service (ai_service/). Photos are sent here after the citizen has a
# tracking ID. Leave unset to run without it: complaints are then flagged for review.
# AI_SERVICE_URL=http://127.0.0.1:8000
# AI_TIMEOUT_MS=20000

# Set to the number of proxies in front of the server so rate limits see client IPs.
# TRUST_PROXY=1

# Where uploaded photos are stored (default: ./uploads).
# UPLOAD_DIR=./uploads

# Nodemailer configuration
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=your_smtp_username
EMAIL_PASS=your_smtp_password
EMAIL_FROM=noreply@complaintsystem.gov

# Employee / research invites — the deep link the invite email points at.
# Default `dsn://` works for a built app. While testing in Expo Go use its scheme,
# e.g. APP_LINK_BASE=exp://192.168.1.42:8081/--/   (must end with a slash)
# APP_LINK_BASE=dsn://

# Set to true to skip the background job that emails researchers 3 days before
# their access ends.
# DISABLE_JOBS=false
