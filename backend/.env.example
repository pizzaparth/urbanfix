PORT=5000
MONGO_URI=mongodb://localhost:27017/complaint_system
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# Nodemailer configuration
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=your_smtp_username
EMAIL_PASS=your_smtp_password
EMAIL_FROM=noreply@complaintsystem.gov

# Employee / research invites — the deep link the invite email points at.
# Default `dsn://` works for a built app. While testing in Expo Go use its scheme,
# e.g. APP_LINK_BASE=exp://192.168.1.42:8081/--/   (must end with a slash)
# APP_LINK_BASE=dsn://

# Set to true to skip the background job that emails researchers 3 days before
# their access ends.
# DISABLE_JOBS=false
